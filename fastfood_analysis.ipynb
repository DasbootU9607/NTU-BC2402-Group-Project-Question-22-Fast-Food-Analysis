import pandas as pd
import plotly.express as px

# 1. import data
# please put the csv file and this python file in the same folder(directory)
file_name = "healthiness_score_for_scatter_plot.csv"

try:
    df = pd.read_csv(file_name)
    print(f"Successful！There are {df.shape[0]} records.")
except FileNotFoundError:
    print(f"Error! Please make sure that '{file_name}' is under the same directory")

# 2. 3D scatter plot
fig = px.scatter_3d(
    df, 
    x="Calories", 
    y="Healthiness Score", 
    z="Protein (g)",
    color="Restaurant", 
    hover_name="Item",
    hover_data=["Category", "Sugar (mg)", "Total Fat (g)", "Sodium (mg)"],
    title="Fast Food Healthiness Analysis: Calories vs. Health Score vs. Protein"
)

# 3. set figure layout
fig.update_layout(
    margin=dict(l=0, r=0, b=0, t=50),
    width=1100,
    height=850,
    font=dict(family="Times New Roman", size=12),
    paper_bgcolor='white'
)

# optimization
fig.update_traces(
    marker=dict(
        size=3,  
        opacity=0.85,
        line=dict(width=1.5, color='white'),
        symbol='circle'
    )
)

# change size
fig.update_traces(
    marker=dict(size=8),
    selector=dict(legendgroup=True)
)

# 4. show
fig.show()
